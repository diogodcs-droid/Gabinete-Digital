{
  "entities": {
    "Sentence": {
      "title": "Sentence",
      "description": "A generated draft sentence for a legal case.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "caseDetails": { "type": "string" },
        "generatedText": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "metadata": {
          "type": "object",
          "properties": {
            "numero_processo": { "type": "string" },
            "reclamante": { "type": "string" },
            "reclamada": { "type": "string" }
          }
        }
      },
      "required": ["userId", "generatedText", "createdAt"]
    }
  },
  "firestore": {
    "sentences": {
      "schema": "Sentence",
      "description": "Collection of legal sentences generated by users."
    }
  }
}
